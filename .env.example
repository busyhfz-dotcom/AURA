# ── Branding ─────────────────────────────────────────────────────────────
VERTEX_BRAND_NAME=VERTEX

# ── Networking ───────────────────────────────────────────────────────────
VERTEX_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_VERTEX_API_URL=http://localhost:8000

# ── Storage ──────────────────────────────────────────────────────────────
VERTEX_DATABASE_PATH=/data/vertex.db

# ── Watchlists (comma-separated, no spaces) ─────────────────────────────
VERTEX_CRYPTO_WATCHLIST=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,DOGEUSDT
VERTEX_FOREX_WATCHLIST=EURUSD,GBPUSD,USDJPY,USDCHF,AUDUSD,USDCAD,XAUUSD

# ── Forex / metals data (crypto works with no key via Binance public API) ─
# Free signup, no credit card: https://twelvedata.com/pricing (Basic/free tier)
VERTEX_FOREX_PROVIDER=twelvedata
VERTEX_FOREX_API_KEY=

# ── Economic news guard ──────────────────────────────────────────────────
# Free signup: https://finnhub.io/register
VERTEX_ECONOMIC_CALENDAR_PROVIDER=finnhub
VERTEX_ECONOMIC_CALENDAR_API_KEY=
VERTEX_NEWS_EMBARGO_BEFORE_MINUTES=30
VERTEX_NEWS_EMBARGO_AFTER_MINUTES=15

# ── Optional: 24/7 push alerts via Telegram ──────────────────────────────
# 1. Message @BotFather on Telegram -> /newbot -> copy the token below.
# 2. Message your new bot once, then open:
#    https://api.telegram.org/bot<token>/getUpdates
#    to find your chat id.
VERTEX_TELEGRAM_BOT_TOKEN=
VERTEX_TELEGRAM_CHAT_ID=

# ── Monitoring tuning ─────────────────────────────────────────────────────
VERTEX_SCAN_INTERVAL_SECONDS=20
# Trade Desk: multi-timeframe (15m/1h/4h) multi-method analysis cycle, per symbol.
# Heavier than the basic scan above, so it defaults to a slower cadence (30-900s allowed).
VERTEX_ANALYSIS_INTERVAL_SECONDS=120
VERTEX_HIGH_VOLATILITY_THRESHOLD_PERCENT=1.5
VERTEX_HIGH_RISK_SCORE_THRESHOLD=70
